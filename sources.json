{
  "_comment": "规则中心。唯一手工维护的文件。CI 从 upstream 拉规则并生成 dist/mihomo/*.yaml 给 FlClash；Loon 直接引用 upstream 原始链接。",
  "version": 4,

  "cdnBase": "https://cdn.jsdelivr.net/gh/A11255/flclash-ruleset@main",

  "_upstreamComment": "数组顺序即规则优先级：先拦截，再系统服务直连，再国内直连，最后代理。policy 可选 REJECT / DIRECT / PROXY。loon:false 表示该源格式不适合 Loon 的 RULE-SET（不进 loon.conf）。",
  "upstream": [
    {
      "name": "Reject_Rule",
      "url": "https://raw.githubusercontent.com/Code-Dramatist/Rule_Actions/main/Reject_Rule/Reject_Rule.rule",
      "policy": "REJECT"
    },
    {
      "name": "AdBlock",
      "url": "https://github.com/dler-io/Rules/raw/refs/heads/main/Surge/Surge%203/Provider/AdBlock.list",
      "policy": "REJECT"
    },
    {
      "name": "adrules",
      "url": "https://adrules.top/adrules.list",
      "policy": "REJECT"
    },
    {
      "name": "rejectAd",
      "url": "https://github.com/fmz200/wool_scripts/raw/main/Loon/rule/rejectAd.list",
      "policy": "REJECT"
    },
    {
      "name": "Adblock4limbo",
      "url": "https://limbopro.com/Adblock4limbo_surge.list",
      "policy": "REJECT",
      "loon": false
    },
    {
      "name": "apple_update",
      "url": "https://github.com/fmz200/wool_scripts/raw/main/Loon/rule/apple_update.list",
      "policy": "DIRECT"
    },
    {
      "name": "Google_FCM",
      "url": "https://github.com/dler-io/Rules/raw/refs/heads/main/Surge/Surge%203/Provider/Google%20FCM.list",
      "policy": "DIRECT"
    },
    {
      "name": "Apple_Push",
      "url": "https://github.com/dler-io/Rules/raw/refs/heads/main/Surge/Surge%203/Provider/Apple%20Push.list",
      "policy": "DIRECT"
    },
    {
      "_note": "以下 7 个来自 kelee.one，被 Cloudflare 按机房 IP 封锁（本机 + GitHub Actions 都拿不到），但手机上的 Loon 可以直连。所以只进 loon.conf，不进 FlClash。flclash:false 表示生成器不会去下载它。",
      "name": "Cloudflarecn",
      "url": "https://rule.kelee.one/Loon/Cloudflarecn.lsr",
      "policy": "DIRECT",
      "flclash": false
    },
    {
      "name": "Cloudflare",
      "url": "https://rule.kelee.one/Loon/Cloudflare.lsr",
      "policy": "DIRECT",
      "flclash": false
    },
    {
      "name": "AppleAccount",
      "url": "https://kelee.one/Tool/Loon/Lsr/AppleAccount.lsr",
      "policy": "DIRECT",
      "flclash": false
    },
    {
      "name": "AppStore",
      "url": "https://kelee.one/Tool/Loon/Lsr/AppStore.lsr",
      "policy": "DIRECT",
      "flclash": false
    },
    {
      "name": "WeChat",
      "url": "https://rule.kelee.one/Loon/WeChat.lsr",
      "policy": "DIRECT",
      "flclash": false
    },
    {
      "name": "Tencent",
      "url": "https://rule.kelee.one/Loon/Tencent.lsr",
      "policy": "DIRECT",
      "flclash": false
    },
    {
      "name": "TestFlight",
      "url": "https://rule.kelee.one/Loon/TestFlight.lsr",
      "policy": "DIRECT",
      "flclash": false
    },
    {
      "name": "Direct_Rule",
      "url": "https://github.com/Code-Dramatist/Rule_Actions/raw/refs/heads/main/Direct_Rule/Direct_Rule.rule",
      "policy": "DIRECT"
    },
    {
      "name": "Proxy_Rule",
      "url": "https://raw.githubusercontent.com/Code-Dramatist/Rule_Actions/main/Proxy_Rule/Proxy_Rule.rule",
      "policy": "PROXY"
    }
  ],

  "guardRules": [
    "GEOIP,LAN,DIRECT,no-resolve",
    "GEOIP,private,DIRECT,no-resolve",
    "IP-CIDR,127.0.0.0/8,DIRECT,no-resolve",
    "IP-CIDR,192.168.0.0/16,DIRECT,no-resolve",
    "IP-CIDR,10.0.0.0/8,DIRECT,no-resolve",
    "IP-CIDR,172.16.0.0/12,DIRECT,no-resolve",
    "IP-CIDR,169.254.0.0/16,DIRECT,no-resolve",
    "IP-CIDR,100.66.1.0/24,DIRECT,no-resolve",
    "IP-CIDR,100.64.0.0/10,DIRECT,no-resolve",
    "IP-CIDR6,::1/128,DIRECT,no-resolve",
    "IP-CIDR6,fc00::/7,DIRECT,no-resolve",
    "IP-CIDR6,fe80::/10,DIRECT,no-resolve"
  ],

  "tailRules": ["GEOIP,CN,DIRECT"],

  "fakeIpFilterExtra": [
    "+.lan",
    "+.local",
    "+.localdomain",
    "+.home.arpa",
    "+.msftconnecttest.com",
    "+.msftncsi.com",
    "localhost.ptlogin2.qq.com"
  ],

  "tunExcludeExtra": ["100.64.0.0/10"],

  "_policyMapComment": "PROXY 必须填对应端真实存在的策略组名。openclash 的值是路由器上 OpenClash 的策略组，改订阅模板后组名变了要同步改这里。",
  "policyMap": {
    "flclash": { "PROXY": "节点选择", "DIRECT": "DIRECT", "REJECT": "REJECT" },
    "loon": { "PROXY": "节点选择", "DIRECT": "DIRECT", "REJECT": "REJECT" },
    "openclash": { "PROXY": "🚀 手动选择", "DIRECT": "DIRECT", "REJECT": "REJECT" }
  },

  "_dropComment": "mihomo 不支持这些规则类型，转换时跳过并写进日志",
  "dropRuleTypes": ["USER-AGENT", "URL-REGEX", "IP-ASN", "AND", "OR", "NOT", "PROCESS-NAME", "GEOIP", "SRC-IP"]
}
